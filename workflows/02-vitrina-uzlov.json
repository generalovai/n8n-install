    {
      "parameters": {
        "jsCode": "// Code нужен, когда готовые узлы не покрывают задачу.\n// Здесь: считаем итоги по всем заказам сразу.\nconst items = $input.all();\nconst sum = items.reduce((acc, it) => acc + (it.json.amount || 0), 0);\nconst paid = items.filter(it => it.json.status === 'оплачен').length;\n\nreturn [{ json: {\n  всего_заказов: items.length,\n  оплачено: paid,\n  общая_сумма: sum,\n  средний_чек: Math.round(sum / items.length)\n} }];"
      },
