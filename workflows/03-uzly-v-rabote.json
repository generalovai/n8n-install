    {
      "parameters": {
        "jsCode": "// Собираем текст отчёта из списков, которые собрал Aggregate.\n// Разметка HTML — её понимает Telegram.\nconst names = $json.name || [];\nconst amounts = $json.amount || [];\nconst cities = $json.city || [];\n\nfunction esc(s) { return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }\n\nconst lines = names.map((n, i) => (i + 1) + '. <b>' + esc(n) + '</b> — ' + (amounts[i] || 0) + ' ₽ (' + esc(cities[i]) + ')');\nconst total = amounts.reduce((a, b) => a + (b || 0), 0);\n\nconst text = '<b>📊 Отчёт по заказам</b>\\n' +\n  'Дата: ' + DateTime.now().toFormat('yyyy-MM-dd') + '\\n\\n' +\n  'Топ-' + names.length + ' оплаченных заказов:\\n' + lines.join('\\n') + '\\n\\n' +\n  'Итого: <b>' + total + ' ₽</b>';\n\nreturn [{ json: { message: text, count: names.length } }];"
      },
      "id": "d2000000-0000-4000-8000-00000000000d",
      "name": "Собираем сообщение",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3712,
        624
      ],
      "notes": "Формирует готовый текст сообщения."
    },
