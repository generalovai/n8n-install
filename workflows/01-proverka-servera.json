    {
      "parameters": {
        "jsCode": "// Собираем всё в одну понятную таблицу.\nconst check = (name, comment) => {\n  let item;\n  try { item = $(name).item.json; } catch (e) { item = null; }\n  if (!item)                    return { сервис: name, статус: 'нет данных', подробности: comment };\n  if (item.error)               return { сервис: name, статус: 'НЕ ДОСТУЧАЛИСЬ', подробности: String(item.error).slice(0, 80) };\n  const code = item.statusCode;\n  if (code === undefined)       return { сервис: name, статус: 'нет данных', подробности: comment };\n  // Для этих сервисов 401/403 без ключа - это ХОРОШО: значит сервер ответил.\n  const ok = code >= 200 && code < 500;\n  return { сервис: name, статус: ok ? 'работает' : 'ошибка', ответ: code, подробности: comment };\n};\n\nconst ipItem = (() => { try { return $('Мой адрес в интернете').item.json; } catch (e) { return null; } })();\nconst ip = ipItem && ipItem.body ? String(ipItem.body).trim() : 'не удалось узнать';\n\nconst rows = [\n  { сервис: 'Мой адрес в интернете', статус: ip, подробности: 'если стоит прокси - здесь должен быть его адрес, не адрес сервера' },\n  check('Google Gemini',  'ключ не нужен: 401 или 403 значит сервер доступен'),\n  check('OpenAI',         'ключ не нужен: 401 значит сервер доступен'),\n  check('ElevenLabs',     'ключ не нужен: 401 значит сервер доступен'),\n  check('Telegram',       '404 - это нормально, значит сервер доступен'),\n  check('Anthropic',      'ключ не нужен: 401 значит сервер доступен'),\n];\n\nconst плохие = rows.filter(r => r.статус === 'НЕ ДОСТУЧАЛИСЬ').map(r => r.сервис);\nrows.push({\n  сервис: 'ИТОГ',\n  статус: плохие.length ? 'есть проблемы' : 'всё доступно',\n  подробности: плохие.length\n    ? 'Не отвечают: ' + плохие.join(', ') + '. Если сервер в России - проверьте прокси: он должен быть указан при установке.'\n    : 'Все сервисы отвечают. Можно подключать ключи и работать.'\n});\n\nreturn rows.map(json => ({ json }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
