    {
      "parameters": {
        "jsCode": "// В режиме \"Run Once for All Items\" обращение $(...).item недоступно -\n// берём .first(). Колонки у всех строк одинаковые, иначе в таблице\n// появляются пустые \"undefined\".\nconst get = (name) => {\n  try { return $(name).first().json || {}; } catch (e) { return { error: 'нода не отработала' }; }\n};\n\nconst check = (name, comment) => {\n  const it = get(name);\n  if (it.error) return { сервис: name, статус: 'НЕ ДОСТУЧАЛИСЬ', ответ: '-', подробности: String(it.error).slice(0, 90) };\n  const code = it.statusCode;\n  if (code === undefined) return { сервис: name, статус: 'нет данных', ответ: '-', подробности: comment };\n  // 401 и 403 без ключа - это хорошо: сервер на связи, просто мы не представились\n  const ok = code >= 200 && code < 500;\n  return { сервис: name, статус: ok ? 'работает' : 'ошибка', ответ: code, подробности: comment };\n};\n\nconst ipIt = get('Мой адрес в интернете');\nconst ip = ipIt.body ? String(ipIt.body).trim() : 'не удалось узнать';\n\nconst rows = [\n  { сервис: 'Мой адрес в интернете', статус: ip, ответ: ipIt.statusCode || '-',\n    подробности: 'если настроен прокси - здесь должен быть его адрес, а не адрес сервера' },\n  check('Google Gemini', 'без ключа 403 - это нормально, сервер доступен'),\n  check('OpenAI',        'без ключа 401 - это нормально, сервер доступен'),\n  check('ElevenLabs',    'без ключа 401 или 404 - это нормально, сервер доступен'),\n  check('Telegram',      'без токена 401 - это нормально, сервер доступен'),\n  check('Anthropic',     'без ключа 401 - это нормально, сервер доступен'),\n];\n\nconst bad = rows.filter(r => r.статус === 'НЕ ДОСТУЧАЛИСЬ').map(r => r.сервис);\nrows.push({\n  сервис: 'ИТОГ',\n  статус: bad.length ? 'есть проблемы' : 'всё доступно',\n  ответ: '-',\n  подробности: bad.length\n    ? 'Не отвечают: ' + bad.join(', ') + '. Если сервер в России - проверьте прокси.'\n    : 'Все сервисы отвечают. Можно подключать ключи и работать.'\n});\n\nreturn rows.map(json => ({ json }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        300
